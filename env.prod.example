# 本番用 .env.prod（このファイルをコピーして .env.prod を作成）
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# DB
RDS_DB_NAME=muybiendb
RDS_USERNAME=postgres
RDS_PASSWORD=strong-password-here
RDS_HOSTNAME=myapp-db
RDS_PORT=5432

POSTGRES_DB=muybiendb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong-password-here

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# フロントの公開 URL（招待メールのパスワード設定リンク等に使用。未設定だと localhost:5173 になる）
FRONTEND_BASE_URL=https://yourdomain.com

# Django Admin（未設定なら /admin/ は無効。一時的に使うときだけ true にして、作業後は外す）
# ADMIN_ENABLED=true

# Email（AWS SES）
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-ses-smtp-user
EMAIL_HOST_PASSWORD=your-ses-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@muybien.jp
CONTACT_NOTIFY_EMAIL=stellastudio4xx@gmail.com

# 異常・攻撃の通知（docs/ALERTS.md）。件名 [ALERT][MuyBienBase][dos|intrusion|error|down] 要約
# 宛先は司令塔の定期タスクが読む Gmail。未設定なら kekenzy@gmail.com、空にすると送らない
# ALERT_EMAIL=kekenzy@gmail.com
ALERT_SERVER_NAME=muybien-lightsail
# 同じ種類の通知の最短間隔（秒）。既定 900（15分に1通まで。間の分は次の通知にまとめる）
# ALERT_COOLDOWN_SECONDS=900

# 日記写真（未設定時はサーバー内の media に保存。設定時は非公開S3 + 署名付きURL）
# Lightsail のインスタンスロールでは書けない。diary/* だけの IAM ユーザーのキーを置く。手順は DIARY_PHOTOS.md
AWS_S3_DIARY_BUCKET=
AWS_S3_REGION=ap-northeast-1
